# TITAN ENTERPRISE CRM v4.0.0 - Environment Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp Configuration  
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Messenger Configuration
MESSENGER_PAGE_ACCESS_TOKEN=your-page-access-token
MESSENGER_VERIFY_TOKEN=your-verify-token
MESSENGER_APP_SECRET=your-app-secret

# Server Configuration
PORT=3000
RPA_SERVER_URL=http://localhost:5000
